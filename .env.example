# Provider credentials (Gateway owns provider access)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Redis / knowledge base
REDIS_URL=your_redis_url_here
REDIS_INDEX_NAME=your_redis_index_name_here

# LiteLLM Gateway
LLM_GATEWAY_URL=http://localhost:4000/v1
LLM_GATEWAY_MODEL=dmp-chat
LLM_GATEWAY_INTENT_MODEL=dmp-intent
LLM_GATEWAY_TIMEOUT_SECONDS=60
LITELLM_MASTER_KEY=change-me

# Application LLM generation
LLM_CHAT_TEMPERATURE=0.7
LLM_CHAT_MAX_TOKENS=300
LLM_INTENT_TEMPERATURE=0
LLM_INTENT_MAX_TOKENS=200

# Gateway deployments
GATEWAY_GROQ_MODEL=groq/openai/gpt-oss-20b
GATEWAY_GEMINI_MODEL=gemini/gemini-2.5-flash
GATEWAY_LOCAL_MODEL=ollama/qwen2.5:1.5b
GATEWAY_LOCAL_API_BASE=http://localhost:11434

# Context Management
# Set max input according to the smallest safe context window in the Gateway fallback chain. Output reserve is kept free for model generation/tool calls.
CONTEXT_MAX_INPUT_TOKENS=8192
CONTEXT_RESERVED_OUTPUT_TOKENS=768
CONTEXT_MAX_HISTORY_TOKENS=3200
CONTEXT_MAX_EXTERNAL_TOKENS=3200
CONTEXT_DEFAULT_SESSION_ID=default

# memory = local/single-process development
# redis  = multi-worker/multi-instance session persistence
CONTEXT_STORE_BACKEND=memory
CONTEXT_SESSION_TTL_SECONDS=86400
CONTEXT_REDIS_KEY_PREFIX=dmp:context
# Optional dedicated Redis. If empty, REDIS_URL is reused.
# CONTEXT_REDIS_URL=redis://...

# Token estimation. If tiktoken is installed, CONTEXT_TOKEN_ENCODING is used;
# otherwise ContextManager falls back to a conservative char-based estimator.
CONTEXT_TOKEN_ENCODING=cl100k_base
CONTEXT_CHARS_PER_TOKEN=3.5
CONTEXT_MESSAGE_OVERHEAD_TOKENS=4

# Voice 
VOICE_ENABLED=true
VOICE_MODEL=base
VOICE_LANGUAGE=vi
VOICE_SAMPLE_RATE=16000
VOICE_DEVICE=cpu
VOICE_TIMEOUT=30
VOICE_OUTPUT_FORMAT=mp3
VOICE_TTS_VOICE=vi-VN-HoaiMyNeural
